{
  "name": "saintbdrh-portfolio",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Portfolio of D. Uuganbadrakh, electronics engineer: a scroll-driven WebGL study of an original six-axis robot arm, his projects, and a live inverse-kinematics lab.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts",
    "model": "blender -b --factory-startup -P blender/build_robot.py -- . --no-render",
    "renders": "blender -b --factory-startup -P blender/build_robot.py -- ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/three": "^0.187.0",
    "astro": "^7.4.13",
    "typescript": "^5.9.3"
  }
}
