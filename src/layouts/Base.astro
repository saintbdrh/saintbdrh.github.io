---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';
import { person } from '../data/content';

const title = `${person.name} — Electronics Engineer`;
const description =
  'D. Uuganbadrakh, electronics engineer in Ulaanbaatar: vision-guided robotics, embedded firmware, industrial control and IoT systems.';
const nav = [
  ['Engineering', '#engineering'],
  ['Thesis', '#thesis'],
  ['Work', '#work'],
  ['Lab', '#lab'],
  ['Profile', '#profile'],
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  worksFor: { '@type': 'Organization', name: person.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National University of Mongolia' },
  address: { '@type': 'PostalAddress', addressLocality: 'Ulaanbaatar', addressCountry: 'MN' },
  email: `mailto:${person.email}`,
  url: 'https://saintbdrh.github.io/',
  sameAs: [person.github],
  knowsLanguage: ['mn', 'en', 'ru'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://saintbdrh.github.io/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#080A0C" />
  <meta name="color-scheme" content="dark" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Vision-guided robotics, embedded firmware, industrial control and IoT systems." />
  <meta property="og:type" content="profile" />
  <meta property="og:url" content="https://saintbdrh.github.io/" />
  <meta property="og:site_name" content={person.name} />
  <meta property="og:image" content="https://saintbdrh.github.io/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="D. Uuganbadrakh, electronics engineer, beside a robot arm workcell diagram" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:image" content="https://saintbdrh.github.io/og-image.png" />
  <link rel="preload" href="/models/robot.glb" as="fetch" type="model/gltf-binary" crossorigin="anonymous" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="stage" aria-hidden="true">
    <img class="stage-still" src="/media/robot-still.webp" alt="" width="1600" height="1000" decoding="async" loading="lazy" />
    <canvas id="stage-canvas"></canvas>
    <svg class="ann" id="stage-ann">
      <path class="ann-line" d="" />
      <circle class="ann-ring" r="7" cx="-20" cy="-20" />
      <circle class="ann-dot" r="2" cx="-20" cy="-20" />
      <text class="ann-label" x="-200" y="-200"></text>
      {['J1', 'J2', 'J3', 'J4', 'J5', 'J6'].map((j) => <text class="ann-axis" x="-200" y="-200">{j}</text>)}
    </svg>
  </div>

  <header class="nav" id="nav">
    <a class="mark" href="#top" aria-label={`${person.name}, back to top`}>
      <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
        <path d="M5 23h18" />
        <path d="M10 23v-6l4.5-7.5 7 2.2" />
        <circle cx="14.5" cy="9.5" r="1.9" class="mark-joint" />
        <circle cx="10" cy="17" r="1.6" />
      </svg>
      <span>{person.name}</span>
    </a>
    <nav aria-label="Sections">
      <ul class="nav-links" id="nav-links">
        {nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        <li><a class="nav-contact" href="#contact">Contact</a></li>
      </ul>
    </nav>
    <a class="nav-mail" href="#contact">Contact</a>
    <button class="nav-menu" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <span class="nav-progress" aria-hidden="true"></span>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-in">
      <p>© 2026 {person.name}, {person.location}</p>
      <p>The robot model is original, built procedurally in Blender. The simulations run in your browser and are not connected to hardware.</p>
    </div>
  </footer>

  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
