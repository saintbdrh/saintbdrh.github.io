---
import { person, thesis, projects, builds } from '../data/content';
import { LINKS } from '../scripts/lab/ik';
import Figures from './Figures.astro';
---
<!-- Scene 01: the DOFBOT at work -->
<section class="scene scene-hero" id="top" data-shot="hero" data-focus="top" aria-labelledby="hero-name">
  <div class="wrap scene-in hero-in">
    <h1 class="display hero-name" id="hero-name" data-intro>{person.name}</h1>
    <p class="hero-roles" data-intro><span>{person.role}</span><span>{person.focus}</span></p>
    <p class="hero-tagline" data-intro>{person.tagline}</p>
    <p class="hero-live data" data-intro aria-hidden="true">
      <span>DOFBOT · <b data-live="task">Idle</b></span>
      <span>q1 <b data-live="q1">0°</b></span><span>q2 <b data-live="q2">0°</b></span>
      <span>q3 <b data-live="q3">0°</b></span><span>q4 <b data-live="q4">0°</b></span>
    </p>
    <p class="hero-note" data-intro>A model of my thesis robot, sorting blocks by hue with the same inverse kinematics, live in your browser.</p>
  </div>
  <a class="scroll-cue" href="#vision"><span>Scroll</span><i aria-hidden="true"></i></a>
</section>

<!-- Scene 02: through the RealSense -->
<section class="scene" id="vision" data-shot="vision" aria-labelledby="vision-h">
  <div class="wrap scene-in caption caption-left">
    <h2 class="display h2" id="vision-h">The camera sees pixels. The arm needs millimetres.</h2>
    <p>An Intel RealSense D435i watches the workspace. HSV segmentation finds each block by colour; AprilTag fiducials fix the workspace frame, and a planar homography maps pixels to millimetres.</p>
    <p class="figure-stat"><span class="stat-value display">{thesis.metric.value}</span><span class="stat-label">{thesis.metric.label}</span></p>
    <p class="caption-fine">Detections drawn here come from the simulated scene, not a camera feed.</p>
  </div>
</section>

<!-- Scene 03: kinematics -->
<section class="scene" id="kinematics" data-shot="kinematics" aria-labelledby="thesis-h">
  <div class="wrap scene-in caption caption-right">
    <h2 class="display h2" id="thesis-h">{thesis.title}</h2>
    <p>{thesis.summary}</p>
    <ol class="pipeline">
      {thesis.stages.map((s) => <li><span class="step-k">{s.k}</span> {s.title}</li>)}
    </ol>
    <dl class="live-joints data" aria-label="Live joint angles">
      <div><dt>q1</dt><dd data-live="q1">–</dd></div><div><dt>q2</dt><dd data-live="q2">–</dd></div>
      <div><dt>q3</dt><dd data-live="q3">–</dd></div><div><dt>q4</dt><dd data-live="q4">–</dd></div>
      <div><dt>x</dt><dd data-live="x">–</dd></div><div><dt>y</dt><dd data-live="y">–</dd></div><div><dt>z</dt><dd data-live="z">–</dd></div>
    </dl>
    <p class="caption-links"><a class="link" href={thesis.repo}>Thesis source</a><a class="link" href="#lab">Drive the arm</a></p>
  </div>
</section>

<!-- Scene 04: the work, as screens around the robot -->
<section class="scene-group" id="work" aria-labelledby="work-h">
  <div class="wrap work-head">
    <h2 class="display h2" id="work-h">Selected work</h2>
  </div>
  {projects.map((p) => (
    <div class="scene scene-panel" data-shot={`panel:${p.id}`}>
      <article class="panel" id={p.id} data-panel aria-labelledby={`${p.id}-h`}>
        <div class="panel-copy">
          <p class="panel-context">{p.context}</p>
          <h3 class="display h3" id={`${p.id}-h`}>{p.title}</h3>
          <p class="panel-sum">{p.summary}</p>
          {p.metric && <p class="figure-stat"><span class="stat-value display">{p.metric.value}</span><span class="stat-label">{p.metric.label}</span></p>}
          <button class="btn" type="button" data-open={`case-${p.id}`}>Read the case study</button>
        </div>
        <div class="panel-fig"><Figures kind={p.figure} title={`${p.title}: ${p.figureNote}`} /></div>
      </article>
    </div>
  ))}
  <div class="scene scene-panel" data-shot="panel:builds">
    <article class="panel panel-builds" id="builds" data-panel aria-labelledby="builds-h">
      <h3 class="display h3" id="builds-h">Smaller builds</h3>
      <ul class="builds-list">
        {builds.map((b) => (
          <li id={b.id}><h4 class="h5">{b.title}</h4><p>{b.text}</p><p class="stack">{b.stack}</p></li>
        ))}
      </ul>
    </article>
  </div>
</section>

{projects.map((p) => (
  <dialog class="case" id={`case-${p.id}`} aria-labelledby={`case-${p.id}-h`}>
    <div class="case-in">
      <button class="case-close btn btn-quiet" type="button" data-close>Close</button>
      <p class="panel-context">{p.context}</p>
      <h2 class="display h2" id={`case-${p.id}-h`}>{p.title}</h2>
      <p class="case-sum">{p.summary}</p>
      <Figures kind={p.figure} title={`${p.title}: ${p.figureNote}`}><figcaption>{p.figureNote}</figcaption></Figures>
      <div class="case-grid">
        <div>
          <h3 class="h5">The problem</h3>
          <p>{p.problem}</p>
          <h3 class="h5">Implementation</h3>
          <ul class="impl">{p.implementation.map((x) => <li><b>{x.b}</b> {x.t}</li>)}</ul>
        </div>
        <div>
          <dl class="spec">{p.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          {p.metric && <p class="figure-stat"><span class="stat-value display">{p.metric.value}</span><span class="stat-label">{p.metric.label}</span></p>}
          <p class="stack"><span class="stack-k">Built with</span> {p.stack.join(' · ')}</p>
          {p.links.length > 0 && <p class="project-links">{p.links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}</p>}
        </div>
      </div>
    </div>
  </dialog>
))}

<!-- Scene 05: the lab — the same arm, yours to drive -->
<section class="scene scene-lab" id="lab" data-shot="lab" aria-labelledby="lab-h">
  <div class="wrap scene-in lab-in">
    <div class="lab-panel" id="lab-panel">
      <h2 class="display h3" id="lab-h">Engineering Lab</h2>
      <p class="lab-desc">Drive the arm with the thesis solver (<a class="link-inline" href="https://github.com/saintbdrh/Vision-guided-robot-sorting/blob/main/ik_core.py">ik_core.py</a>) and the measured links <span class="data">L1 {LINKS.L1}, L2 {LINKS.L2}, L3 {LINKS.L3}, L4 {LINKS.L4}, L5 {LINKS.L5} mm</span>. A simulation; no hardware is connected.</p>
      <div class="seg" role="radiogroup" aria-label="Mode">
        <label><input type="radio" name="lab-mode" value="ik" checked /><span>Inverse</span></label>
        <label><input type="radio" name="lab-mode" value="fk" /><span>Forward</span></label>
      </div>
      <fieldset class="sliders" id="lab-ik-inputs">
        <legend class="sr">Tool target, millimetres</legend>
        {[['x', 'X', 0, 260, 170, 'mm'], ['y', 'Y', -200, 200, 30, 'mm'], ['z', 'Z', 0, 300, 60, 'mm'], ['pitch', 'Pitch', -90, 30, -70, '°']].map(([id, label, min, max, val, unit]) => (
          <div class="slider"><label for={`ik-${id}`}>{label}</label><input type="range" id={`ik-${id}`} data-k={id} min={min} max={max} value={val} /><output class="data" data-unit={unit}>{val}</output></div>
        ))}
      </fieldset>
      <fieldset class="sliders" id="lab-fk-inputs" hidden>
        <legend class="sr">Joint angles, degrees</legend>
        {[['q1', 'q1 base', -135, 135, 10], ['q2', 'q2 shoulder', -40, 100, 60], ['q3', 'q3 elbow', -135, 135, -60], ['q4', 'q4 wrist', -160, 160, -50]].map(([id, label, min, max, val]) => (
          <div class="slider"><label for={`fk-${id}`}>{label}</label><input type="range" id={`fk-${id}`} data-k={id} min={min} max={max} value={val} /><output class="data" data-unit="°">{val}</output></div>
        ))}
      </fieldset>
      <p class="lab-status" id="lab-status" role="status" aria-live="polite">Scroll here to take control of the arm.</p>
      <dl class="readout data">
        <div><dt>q1</dt><dd data-live="q1">–</dd></div><div><dt>q2</dt><dd data-live="q2">–</dd></div>
        <div><dt>q3</dt><dd data-live="q3">–</dd></div><div><dt>q4</dt><dd data-live="q4">–</dd></div>
        <div><dt>tool x</dt><dd data-live="x">–</dd></div><div><dt>tool y</dt><dd data-live="y">–</dd></div>
      </dl>
      <div class="lab-actions">
        <button class="btn" type="button" id="lab-run">Run thesis pick sequence</button>
        <button class="btn btn-quiet" type="button" data-open="workcell-dialog">Planar workcell</button>
      </div>
    </div>
  </div>
</section>

<dialog class="case" id="workcell-dialog" aria-labelledby="workcell-h">
  <div class="case-in">
    <button class="case-close btn btn-quiet" type="button" data-close>Close</button>
    <h2 class="display h3" id="workcell-h">Planar workcell</h2>
    <p class="case-sum">From the previous version of this site: a three-joint arm with the tool held vertical, solved with the same geometric method. Select a block to sort it by hue, or point at the cell to steer the arm.</p>
    <div class="cell" id="workcell">
      <div class="cell-bar"><p class="cell-title">Elevation view, mm</p><label class="check"><input type="checkbox" id="det-toggle" checked /><span>Detections</span></label></div>
      <svg id="cell" viewBox="0 0 460 330" role="group" aria-labelledby="cell-t cell-d"><title id="cell-t">Robot arm workcell</title><desc id="cell-d">A three-joint arm solved with geometric inverse kinematics. Select a block to sort it into the bin of matching hue.</desc></svg>
      <dl class="cell-tm data" aria-hidden="true">
        <div><dt>θ1 shoulder</dt><dd id="tm-a1">0.0°</dd></div><div><dt>θ2 elbow</dt><dd id="tm-a2">0.0°</dd></div>
        <div><dt>θ3 wrist</dt><dd id="tm-a3">0.0°</dd></div><div><dt>Gripper</dt><dd id="tm-g">Open</dd></div>
        <div><dt>Tool X</dt><dd id="tm-x">0.0 mm</dd></div><div><dt>Tool Y</dt><dd id="tm-y">0.0 mm</dd></div>
        <div><dt>State</dt><dd id="tm-s">Idle</dd></div><div><dt>Sorted</dt><dd id="tm-n">0 of 3</dd></div>
      </dl>
      <div class="cell-foot"><button class="btn" type="button" id="sort-all">Sort all</button><button class="btn btn-quiet" type="button" id="reset" disabled>Reset</button></div>
      <p class="sr" aria-live="polite" id="cell-live"></p>
    </div>
  </div>
</dialog>
