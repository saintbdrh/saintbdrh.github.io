---
import { projects, builds } from '../data/content';
import Figures from './Figures.astro';
---
<section class="work" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 class="display h2" id="work-h">Selected work</h2>
      <p class="lead">Four systems in depth: architecture, implementation and the results that were measured. Smaller builds follow.</p>
    </header>

    {projects.map((p, i) => (
      <article class={`project${i % 2 ? ' project-flip' : ''}`} id={p.id} aria-labelledby={`${p.id}-h`}>
        <div class="project-intro" data-reveal>
          <h3 class="display h3" id={`${p.id}-h`}>{p.title}</h3>
          <p class="project-context">{p.context}</p>
          <p class="project-summary">{p.summary}</p>
          {p.metric && (
            <div class="figure-stat">
              <p class="stat-value display">{p.metric.value}</p>
              <p class="stat-label">{p.metric.label}</p>
            </div>
          )}
        </div>
        <div class="project-figure" data-reveal>
          <Figures kind={p.figure} title={`${p.title}: ${p.figureNote}`}>
            <figcaption>{p.figureNote}</figcaption>
          </Figures>
        </div>
        <div class="project-body" data-reveal>
          <h4 class="h5">The problem</h4>
          <p>{p.problem}</p>
          <h4 class="h5">Implementation</h4>
          <ul class="impl">
            {p.implementation.map((x) => <li><b>{x.b}</b> {x.t}</li>)}
          </ul>
        </div>
        <div class="project-spec" data-reveal>
          <dl class="spec">
            {p.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="stack"><span class="stack-k">Built with</span> {p.stack.join(' · ')}</p>
          {p.links.length > 0 && (
            <p class="project-links">{p.links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}</p>
          )}
        </div>
      </article>
    ))}

    <section class="builds" aria-labelledby="builds-h">
      <h3 class="h4" id="builds-h" data-reveal>Smaller builds</h3>
      <ul class="builds-list">
        {builds.map((b) => (
          <li class="build" id={b.id} data-reveal>
            <h4 class="h5">{b.title}</h4>
            <p>{b.text}</p>
            <p class="stack">{b.stack}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>
