---
/**
 * Project figures, drawn as line work in the site's palette. Each figure
 * depicts the documented architecture or method; none shows invented data.
 */
interface Props { kind: 'homography' | 'gesture' | 'greenhouse' | 'conveyor'; title: string }
const { kind, title } = Astro.props;

// MediaPipe hand: 21 landmarks (wrist, then 4 per finger). Schematic open palm.
const hand: [number, number][] = [
  [150, 250],
  [118, 232], [96, 206], [82, 182], [70, 160],          // thumb 1-4
  [128, 168], [124, 128], [122, 102], [120, 80],        // index 5-8
  [150, 162], [150, 118], [150, 90], [150, 66],         // middle 9-12
  [172, 166], [176, 126], [178, 100], [180, 80],        // ring 13-16
  [192, 178], [202, 148], [208, 128], [212, 110],       // pinky 17-20
];
const bones = [[0,1],[1,2],[2,3],[3,4],[0,5],[5,6],[6,7],[7,8],[5,9],[9,10],[10,11],[11,12],[9,13],[13,14],[14,15],[15,16],[13,17],[0,17],[17,18],[18,19],[19,20]];
const tips = [8, 12, 16, 20];
---
<figure class={`fig fig-${kind}`}>
  {kind === 'homography' && (
    <svg viewBox="0 0 560 300" role="img" aria-labelledby="fh-t">
      <title id="fh-t">{title}</title>
      <g class="f-frame">
        <rect x="16" y="40" width="230" height="170" rx="3" />
        <text class="f-label" x="16" y="28">Camera image, pixels</text>
      </g>
      <path class="f-plane" d="M58 186 L204 186 L180 82 L84 82 Z" />
      <g class="f-grid">
        <path d="M70.5 134 H192 M76 108 H186 M63 160 H198 M107 186 L119 82 M131 186 L131 82 M155 186 L143 82 M83 186 L107 82 M179 186 L155 82" />
      </g>
      {[[58,186],[204,186],[180,82],[84,82]].map(([x,y]) => (
        <g class="f-tag" transform={`translate(${x - 7} ${y - 7})`}><rect width="14" height="14" /><rect x="4" y="4" width="6" height="6" class="f-tag-in" /></g>
      ))}
      <ellipse class="f-object" cx="146" cy="128" rx="10" ry="7" />
      <path class="f-cross" d="M146 116 V140 M134 128 H158" />

      <g class="f-arrow">
        <path class="f-wire" d="M262 125 H318" />
        <path d="M312 119 L320 125 L312 131" />
        <text class="f-label f-mid" x="290" y="112">H, 3×3</text>
      </g>

      <g class="f-frame">
        <rect x="334" y="40" width="210" height="170" rx="3" />
        <text class="f-label" x="334" y="28">Workspace plane, mm</text>
      </g>
      <g class="f-grid">
        {[0,1,2,3,4,5,6].map((i) => <path d={`M${354 + i * 28} 60 V190`} />)}
        {[0,1,2,3,4].map((i) => <path d={`M354 ${60 + i * 32.5} H522`} />)}
      </g>
      {[[354,190],[522,190],[522,60],[354,60]].map(([x,y]) => (
        <g class="f-tag" transform={`translate(${x - 7} ${y - 7})`}><rect width="14" height="14" /><rect x="4" y="4" width="6" height="6" class="f-tag-in" /></g>
      ))}
      <circle class="f-object" cx="452" cy="118" r="9" />
      <path class="f-cross" d="M452 104 V132 M438 118 H466" />
      <text class="f-data" x="466" y="104">(x, y)</text>
      <path class="f-dim" d="M354 222 H522 M354 217 V227 M522 217 V227" />
      <text class="f-label f-mid" x="438" y="244">AprilTag-anchored frame</text>
      <text class="f-label" x="16" y="244">HSV mask → centroid → homography → XYZ target</text>
      <text class="f-data" x="16" y="272">mean calibration error 2.8 mm</text>
    </svg>
  )}

  {kind === 'gesture' && (
    <div class="fig-gesture-in">
      <svg viewBox="40 40 220 256" role="img" aria-labelledby="fg-t">
        <title id="fg-t">{title}</title>
        <g class="f-bones">
          {bones.map(([a, b]) => <path d={`M${hand[a][0]} ${hand[a][1]} L${hand[b][0]} ${hand[b][1]}`} />)}
        </g>
        {tips.map((t, i) => <path class="f-pinch" style={`--i:${i}`} d={`M${hand[4][0]} ${hand[4][1]} L${hand[t][0]} ${hand[t][1]}`} />)}
        {hand.map(([x, y], i) => <circle class={i === 4 || tips.includes(i) ? 'f-node f-tip' : 'f-node'} cx={x} cy={y} r={i === 0 ? 4 : 3} />)}
        <path class="f-dim" d="M64 270 H236 M64 264 V276 M236 264 V276" />
        <text class="f-label f-mid" x="150" y="290">lateral position → base</text>
      </svg>
      <dl class="gesture-map">
        <div><dt>Hand left / right</dt><dd>Base rotation</dd></div>
        <div><dt>Thumb + index</dt><dd>Shoulder forward</dd></div>
        <div><dt>Thumb + middle</dt><dd>Elbow down</dd></div>
        <div><dt>Thumb + ring</dt><dd>Wrist down</dd></div>
        <div><dt>Thumb + pinky touch</dt><dd>Gripper open</dd></div>
        <div><dt>Thumb + pinky apart</dt><dd>Gripper close</dd></div>
      </dl>
    </div>
  )}

  {kind === 'greenhouse' && (
    <svg viewBox="0 0 560 320" role="img" aria-labelledby="fgh-t">
      <title id="fgh-t">{title}</title>
      <g class="f-house">
        <path d="M20 282 V140 L160 58 L300 140 V282 Z" />
        <path d="M20 140 H300" class="f-faint" />
        <path d="M34 282 V256 H286 V282" class="f-bed" />
      </g>
      <g class="f-sensor"><circle cx="160" cy="86" r="5" /><text class="f-label" x="172" y="90">LDR light</text></g>
      <g class="f-act"><path d="M112 120 H208" /><text class="f-label f-mid" x="160" y="110">Grow lights</text></g>
      <g class="f-sensor"><circle cx="46" cy="166" r="5" /><text class="f-label" x="58" y="170">DHT22</text><text class="f-label" x="58" y="184">air temp., humidity</text></g>
      <g class="f-act"><rect x="234" y="150" width="30" height="30" rx="15" /><text class="f-label f-mid" x="249" y="196">Fan</text></g>
      <g class="f-node-box"><rect x="108" y="204" width="104" height="34" rx="3" /><text class="f-label f-mid f-strong" x="160" y="225">ESP32 #2 node</text></g>
      <g class="f-act"><rect x="44" y="264" width="30" height="10" rx="2" /><text class="f-label" x="82" y="273">Pump</text></g>
      <g class="f-sensor"><path d="M250 250 V276" /><circle cx="250" cy="246" r="4" /><text class="f-label f-end" x="240" y="250">Soil probe</text></g>

      <path class="f-wire f-flow" d="M212 216 H340" />
      <path class="f-wire f-flow f-rev" d="M340 226 H212" />
      <text class="f-data f-mid" x="318" y="246">ESP-NOW</text>

      <g class="f-node-box"><rect x="340" y="198" width="108" height="44" rx="3" /><text class="f-label f-mid f-strong" x="394" y="217">ESP32 #1 hub</text><text class="f-label f-mid" x="394" y="233">control logic</text></g>

      <path class="f-wire f-flow" d="M394 198 V122" />
      <text class="f-data" x="402" y="164">Wi-Fi</text>
      <g class="f-node-box f-ext"><rect x="330" y="74" width="128" height="48" rx="3" /><text class="f-label f-mid f-strong" x="394" y="96">Web dashboard</text><text class="f-label f-mid" x="394" y="112">HTML, CSS, JS</text></g>

      <path class="f-wire f-flow" d="M448 220 H508 V122" />
      <g class="f-node-box f-ext"><rect x="470" y="74" width="76" height="48" rx="3" /><text class="f-label f-mid f-strong" x="508" y="96">Telegram</text><text class="f-label f-mid" x="508" y="112">alerts</text></g>
      <text class="f-label" x="20" y="308">Field node in the greenhouse, hub with the operators. Schematic, not to scale.</text>
    </svg>
  )}

  {kind === 'conveyor' && (
    <svg viewBox="0 0 560 330" role="img" aria-labelledby="fc-t">
      <title id="fc-t">{title}</title>
      <text class="f-label f-strong" x="16" y="30">Interlock layer</text>
      <g class="f-node-box"><rect x="16" y="44" width="120" height="44" rx="3" /><text class="f-label f-mid" x="76" y="64">E-stop,</text><text class="f-label f-mid" x="76" y="79">light curtains</text></g>
      <path class="f-wire f-flow" d="M136 66 H178" />
      <g class="f-node-box"><rect x="178" y="44" width="172" height="44" rx="3" /><text class="f-label f-mid f-strong" x="264" y="64">Siemens S7-1200</text><text class="f-label f-mid" x="264" y="79">ladder logic, safety relays</text></g>

      <text class="f-label f-strong" x="16" y="134">Vision layer</text>
      <g class="f-node-box"><rect x="16" y="148" width="120" height="44" rx="3" /><text class="f-label f-mid" x="76" y="175">Camera</text></g>
      <path class="f-wire f-flow" d="M136 170 H178" />
      <g class="f-node-box"><rect x="178" y="148" width="172" height="44" rx="3" /><text class="f-label f-mid f-strong" x="264" y="168">Embedded IPC, OpenCV</text><text class="f-label f-mid" x="264" y="183">proximity, intrusion, misalignment</text></g>

      <path class="f-wire f-flow" d="M350 66 H382 V104 H402" />
      <path class="f-wire f-flow" d="M350 170 H382 V132 H402" />
      <path class="f-gate" d="M402 96 Q428 96 440 118 Q428 140 402 140 Q414 118 402 96 Z" />
      <text class="f-data f-mid" x="420" y="160">OR</text>
      <path class="f-wire f-stop" d="M440 118 H470" />
      <g class="f-node-box f-key"><rect x="470" y="96" width="76" height="44" rx="3" /><text class="f-label f-mid f-strong" x="508" y="116">Stop</text><text class="f-data f-mid" x="508" y="131">&lt; 50 ms</text></g>

      <g class="f-node-box f-ext"><rect x="178" y="236" width="172" height="40" rx="3" /><text class="f-label f-mid f-strong" x="264" y="254">HMI panel</text><text class="f-label f-mid" x="264" y="268">status, event log</text></g>
      <path class="f-wire f-faint" d="M178 256 H160 V78 H178" />
      <text class="f-label" x="16" y="250">status, events</text>
      <text class="f-label" x="16" y="264">to and from the PLC</text>

      <g class="f-belt">
        <circle cx="400" cy="276" r="14" /><circle cx="530" cy="276" r="14" />
        <path d="M400 262 H530 M400 290 H530" />
        <path class="f-belt-move" d="M400 262 H530" />
      </g>
      <path class="f-wire f-stop" d="M508 140 V258" />
      <text class="f-label" x="400" y="316">Conveyor drive</text>
    </svg>
  )}
  <slot />
</figure>
