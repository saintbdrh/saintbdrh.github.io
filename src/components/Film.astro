---
import { person, capabilities, thesis } from '../data/content';
---
<div class="film" id="film">
  <!-- Scene 01: introduction -->
  <section class="hero" id="top" data-shot="hero" data-focus="top" aria-labelledby="hero-name">
    <div class="wrap hero-in">
      <div class="hero-copy" data-intro>
        <h1 class="display hero-name" id="hero-name">{person.name}</h1>
        <p class="hero-roles"><span>{person.role}</span><span>{person.focus}</span></p>
        <p class="hero-tagline">{person.tagline}</p>
        <dl class="telemetry" id="telemetry" aria-label="Live joint angles of the illustrative arm">
          {['J1', 'J2', 'J3', 'J4', 'J5', 'J6'].map((j) => (
            <div><dt>{j}</dt><dd data-j>  0.0°</dd></div>
          ))}
        </dl>
        <p class="hero-note">Joint angles of an original, illustrative six-axis model, not the thesis hardware.</p>
      </div>
      <a class="scroll-cue" href="#engineering" data-intro>
        <span>Scroll</span><i aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <!-- Scene 02: engineering -->
  <section class="chapter" id="engineering" aria-labelledby="eng-h">
    <header class="wrap chapter-head" data-shot="hero" data-reveal>
      <h2 class="display h2" id="eng-h">Engineering across the signal chain</h2>
      <p class="lead">{person.summary} Five disciplines, each anchored to the mechanism it would live in.</p>
    </header>
    <ol class="caps">
      {capabilities.map((c) => (
        <li class="cap wrap" id={`cap-${c.id}`} data-shot={`cap-${c.id}`} data-anchor={c.anchor} data-part={c.part}>
          <div class="cap-text" data-reveal>
            <h3 class="display h3" data-ann-from>{c.title}</h3>
            <p>{c.text}</p>
            <p class="data cap-part">{c.part}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Scene 03: robotics thesis -->
  <section class="chapter thesis" id="thesis" aria-labelledby="thesis-h">
    <header class="wrap chapter-head thesis-head" data-shot="thesis-intro" data-reveal>
      <h2 class="display h2" id="thesis-h">{thesis.title}</h2>
      <p class="lead">{thesis.summary}</p>
      <div class="figure-stat">
        <p class="stat-value display">{thesis.metric.value}</p>
        <p class="stat-label">{thesis.metric.label}</p>
      </div>
      <p class="note">The six-axis arm on this page is an original illustrative model, exploded here to show joint coordination. The thesis hardware was a Yahboom DOFBOT servo arm, whose real geometry runs in the <a href="#lab">Engineering Lab</a>.</p>
    </header>
    <ol class="pipeline wrap" aria-label="Thesis pipeline, in signal order">
      {thesis.stages.map((s, i) => (
        <li class="stage-step" data-shot={['thesis-a', 'thesis-a', 'thesis-b', 'thesis-b', 'thesis-c', 'thesis-c'][i]} data-reveal>
          <h3 class="h4">{s.title}</h3>
          <p><span class="step-k">{s.k}.</span> {s.text}</p>
        </li>
      ))}
    </ol>
    <p class="wrap thesis-more" data-reveal>
      <a class="link" href={thesis.repo}>Thesis source on GitHub</a>
      <a class="link" href="#lab">Run the solver</a>
    </p>
  </section>
</div>
